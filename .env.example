# Redis connection.
#
# Development (local, no auth):
REDIS_URL=redis://localhost:6379
#
# Production (REQUIRED): use TLS + auth. Never expose plaintext Redis.
# REDIS_URL=rediss://:YOUR_STRONG_PASSWORD@redis-host:6380

# Optional: Redis password (used by docker-compose to configure the server)
# REDIS_PASSWORD=change-me
